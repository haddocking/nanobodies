\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {HADDOCK acceptable success rate (acc. SR) on cases that are difficult for AlphaFold.} Instances for which AlphaFold2-multimer and AlphaFold3 lack an acceptable model (according to CAPRI criteria) in the first 10 ranked models are displayed (AF2 Failed, AF3 Failed). Additionally, nanobody antigen complexes where AlphaFold's maximum ipTM $< 0.6$ are shown (AF2 Low ipTM, AF3 Low ipTM). HADDOCK acceptable SR are reported across the three scenarios, as calculated over the best ranked model of the IBMu ensemble run (see main text). Statistics calculated for the first ten models are provided between square brackets.}}{8}{}\protected@file@percent }
\newlabel{tab:af2_af3_stats}{{2}{8}{}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Fraction of Native Contacts improves after Flexible Refinement}. The histograms show the distribution of changes in Fnat after flexible refinement ($\Delta F_{nat} = F_{nat}^{flex} - F_{nat}^{rigid}$) for all acceptable models (positive values indicate an improvement in the recovery of native contacts). Frequencies are shown for True, Loose and Two-Hit interface scenarios runs with bound and unbound antigen. The median $\Delta F_{nat}$ value is shown at the bottom of the histogram and maximum and minimum $\Delta F_{nat}$ are reported with black dashed lines. The number of models in the plotted distributions (n) is shown on each graph.}}{8}{}\protected@file@percent }
\newlabel{fig:refinement}{{3}{8}{}{figure.3}{}}
